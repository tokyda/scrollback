# Copy to .env (git-ignored) and fill in. Environment variables override config.yaml.

# --- Secrets ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs the bot will answer (DESIGN §4.6)
TELEGRAM_ALLOWED_CHAT_IDS=
# Bearer token for the optional HTTP API (stretch)
API_BEARER_TOKEN=

